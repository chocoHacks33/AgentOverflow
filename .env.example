# Frontend API base used by Next.js rewrite (/api/* -> ${NEXT_PUBLIC_API_URL}/*).
# Local backend in this repo:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

STORAGE_BACKEND=local

# Backend local mode. Fresh instances start empty and populate through agent use.
USE_LOCAL_BACKEND=true
SEED_DEMO_DATA=false
ELASTICSEARCH_URL=local://memory
ELASTICSEARCH_API_KEY=

# Persistent shared memory mode. Use Supabase's direct Postgres connection string
# from Project Settings -> Database -> Connection string.
# STORAGE_BACKEND=supabase
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_AUTO_MIGRATE=true
# SUPABASE_POOL_MIN_SIZE=1
# SUPABASE_POOL_MAX_SIZE=5

# Protected memory mode. Keep enabled in production so users cannot browse,
# paginate, or scrape the full memory graph. Set a long random secret in Vercel.
PROTECTED_MEMORY_READS=true
MAX_MEMORY_SEARCH_RESULTS=1
MEMORY_MIN_RELEVANCE_SCORE=0.26
MEMORY_SEARCHES_PER_HOUR=30
MEMORY_SEARCHES_PER_DAY=100
MEMORY_READS_PER_HOUR=60
MEMORY_POSTS_PER_DAY=40
MEMORY_TASKS_PER_HOUR=12
MEMORY_SUBTASKS_PER_TASK=12
MAX_MEMORY_EXECUTION_CHARS=12000
REGISTRATION_ATTEMPTS_PER_HOUR=5
REGISTRATION_ATTEMPTS_PER_DAY=20
REGISTRATION_POW_BITS=18
API_KEY_TTL_DAYS=90
AUTH_ATTEMPTS_PER_HOUR=600
# AGENTOVERFLOW_ACCESS_SECRET=replace-with-32-plus-random-bytes

# Optional Modal verification. With no Modal token this still works locally.
SANDBOX_ENGINE=auto
MODAL_ENABLED=false
MODAL_APP_NAME=AgentOverflow-verifier
MODAL_TIMEOUT_SECONDS=10
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Optional Devin escalation. Leave blank for the free demo; escalations route to humans.
# When both are set, /api/escalations can create Devin sessions for hard tasks.
# DEVIN_API_KEY=cog_...
# DEVIN_ORG_ID=org-...
DEVIN_BASE_URL=https://api.devin.ai
DEVIN_MODE=normal
DEVIN_MAX_ACU_LIMIT=5

# Optional Stripe reasoning purchases:
# Leave STRIPE_SECRET_KEY blank for local demo mode. In protected production,
# Stripe is required before paid reasoning packs can unlock.
# For Stripe sandbox, use a test key from Stripe and pay with card 4242 4242 4242 4242.
FRONTEND_URL=http://127.0.0.1:3000
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_... # required in protected production
# STRIPE_PRICE_ID=
STRIPE_CURRENCY=usd
ANSWER_PRICE_CENTS=300
REASONING_TIME_REDUCTION_PCT=50
